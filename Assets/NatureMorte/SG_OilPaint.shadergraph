{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "95a28e7b85e24cd88af5628872fd7123",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "OilPaint (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -318.66668701171877,
            "y": -376.66668701171877,
            "width": 232.66665649414063,
            "height": 328.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "9b9f5d4f165d4416a8ac91c67ea3aa0e"
        },
        {
            "m_Id": "e92cada102da4c5d89b6a368f8fe6729"
        },
        {
            "m_Id": "bf3740d149364f7e98915b78718f5685"
        },
        {
            "m_Id": "4226f12511344c438a807e15e3848df0"
        },
        {
            "m_Id": "ce1204f16cd9418e8240c04c31020e5f"
        },
        {
            "m_Id": "bce411e6f8484917b654b1ea6e2fced7"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "OilPaint",
    "m_FunctionSource": "1b8734ce135fd26439c6f738bde99e8c",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "int intensityCount[10];\nfloat avgR[10];\nfloat avgG[10];\nfloat avgB[10];\n\nfor (int iLevel = 0; iLevel < 10; iLevel++)\n{\n    intensityCount[iLevel] = 0;\n    avgR[iLevel] = 0.0;\n    avgG[iLevel] = 0.0;\n    avgB[iLevel] = 0.0;\n}\n\nint r = (int)Radius;\n\nfor (int i = 0; i < r; ++i)\n{\n    int offsetI = -(r / 2) + i;\n    float v = UV.y + offsetI * InvSize.y;\n\n    for (int j = 0; j < r; ++j)\n    {\n        int offsetJ = -(r / 2) + j;\n        float u = UV.x + offsetJ * InvSize.x;\n\n      float3 tex = SAMPLE_TEXTURE2D_X_LOD(_CameraOpaqueTexture, sampler_CameraOpaqueTexture, float2(u, v), 0).rgb;\n\n        float currentIntensity = ((tex.r + tex.g + tex.b) / 3.0 * 10.0);\n        int intensityIndex = min((int)currentIntensity, 9);\n\n        intensityCount[intensityIndex]++;\n        avgR[intensityIndex] += tex.r;\n        avgG[intensityIndex] += tex.g;\n        avgB[intensityIndex] += tex.b;\n    }\n}\n\nfloat maxIntensity = 0.0;\nint maxIndex = 0;\n\nfor (int cLevel = 0; cLevel < 10; cLevel++)\n{\n    if (intensityCount[cLevel] > maxIntensity)\n    {\n        maxIntensity = intensityCount[cLevel];\n        maxIndex = cLevel;\n    }\n}\n\nif (maxIntensity <= 0.0)\n{\n    Out = float3(0.0, 0.0, 0.0);\n}\nelse\n{\n    Out = float3(avgR[maxIndex], avgG[maxIndex], avgB[maxIndex]) / maxIntensity;\n}"
}

